# Bot opérations Eddy — prem-eu2:21268 — copier vers /home/container/.env

BOT_ROLE=ops
BOT_ID=eddy-ops
BOT_HTTP_PORT=21268
BOT_LEASE_SECONDS=1800
BOT_REPO_URL=https://github.com/OWNER/box-plus.git
BOT_REPO_BRANCH=main
BOT_CATALOG_PUSH_ENABLED=false

# Ops quotidien 15h (Paris) : impayes AM04 sur ce bot (1 Go RAM)
BOT_DAILY_OPS_HOUR=15
BOT_DAILY_OPS_POLL_MS=60000
DAILY_OPS_APPLY=1
DAILY_OPS_SKIP_MIGRATION=1
# Migration Balma/EU : PC ou autre host avec BALMA_MIGRATE_DAILY=1
# BALMA_MIGRATE_DAILY=1
# BALMA_MIGRATE_MIN_FREE_MB=280
# DAILY_OPS_RUN_NOW=1
# DAILY_OPS_DRY_RUN=1

# GitHub parfois timeout depuis le panel
BOT_GIT_FETCH_ATTEMPTS=6
BOT_GIT_FETCH_RETRY_MS=20000
BOT_GIT_FETCH_TIMEOUT_MS=180000

# Registre partagé de fiabilité / idempotence (service_role uniquement)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Même secret que Vercel / boutique
SYNC_SECRET=

# Deciplus — compte opérations Eddy
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=EDDY
DECIPLUS_PASSWORD=
DECIPLUS_DEFAULT_SITE=Minimes
DECIPLUS_HEADLESS=true
DECIPLUS_FAST=1
DECIPLUS_IMAP_USER=
DECIPLUS_IMAP_PASS=
DECIPLUS_IMAP_HOST=imap.gmail.com
DECIPLUS_IMAP_PORT=993

# Boutique
BOXPLUS_STORE_URL=https://boutique.boxingcenter.fr
STORE_INGEST_URL=https://boutique.boxingcenter.fr/api/admin/ingest-catalog

# Alertes + mails ops — Brevo uniquement
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Boxing Center
BREVO_REPLY_TO=contact@example.com
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
SMS_GATEWAY_URL=http://127.0.0.1:21724
SMS_GATEWAY_EMAIL=
SMS_GATEWAY_PASSWORD=
