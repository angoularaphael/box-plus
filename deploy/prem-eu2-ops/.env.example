# Bot opérations Eddy — prem-eu2:21268 — copier vers /home/container/.env

BOT_ROLE=ops
BOT_ID=eddy-ops
BOT_HTTP_PORT=21268
BOT_LEASE_SECONDS=1800
BOT_REPO_URL=https://github.com/angoularaphael/boxi-deci-bot.git
BOT_REPO_BRANCH=main
BOT_CATALOG_PUSH_ENABLED=false

# Registre partagé de fiabilité / idempotence (service_role uniquement)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Même secret que Vercel / boutique
SYNC_SECRET=

# Deciplus — compte opérations Eddy
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=EDDY
DECIPLUS_PASSWORD=
DECIPLUS_DEFAULT_SITE=Minimes
DECIPLUS_HEADLESS=true
DECIPLUS_FAST=1
DECIPLUS_IMAP_USER=
DECIPLUS_IMAP_PASS=
DECIPLUS_IMAP_HOST=imap.gmail.com
DECIPLUS_IMAP_PORT=993

# Boutique
BOXPLUS_STORE_URL=https://boutique.boxingcenter.fr
STORE_INGEST_URL=https://boutique.boxingcenter.fr/api/admin/ingest-catalog

# Alertes optionnelles — ne renseigner que des destinations existantes
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
RESEND_REPLY_TO=
