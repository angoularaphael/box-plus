# Bot maintenance prem-eu2 — copier vers /home/container/.env

BOT_ROLE=ops
BOT_HTTP_PORT=21871
BOT_REPO_URL=https://github.com/angoularaphael/box-plus.git
BOT_REPO_BRANCH=main

# Même secret que Vercel / boutique
SYNC_SECRET=

# Deciplus (compte manager)
DECIPLUS_EMAIL=
DECIPLUS_PASSWORD=
DECIPLUS_HEADLESS=true
DECIPLUS_FAST=1

# Boutique (relances cron)
BOXPLUS_STORE_URL=https://boutique.boxingcenter.fr

# Supabase (scripts audit si lancés sur ce serveur)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOXPLUS_ORDERS_REMOTE=1

# Resend (relances RIB)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
RESEND_REPLY_TO=boxingcentertls@gmail.com
