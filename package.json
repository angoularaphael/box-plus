{
  "name": "boxplus-deciplus",
  "version": "1.0.0",
  "private": true,
  "description": "Analyse et automatisation Deciplus pour Boxing Center (PrestaShop → Deciplus)",
  "scripts": {
    "_note_prepare": "npm install branche le crochet qui retire les signatures d'outil des messages de commit (voir .githooks/commit-msg)",
    "prepare": "git config core.hooksPath .githooks",
    "dev": "node storefront/server.js",
    "analyze:record": "node analyzer/record-session.js",
    "analyze:scenario": "node analyzer/run-scenario.js",
    "analyze:report": "node analyzer/generate-report.js",
    "bot:run": "node bot/index.js",
    "start:bot": "node start.js",
    "bridge:start": "node bridge/server.js",
    "prestashop:sync": "node bridge/prestashop-sync.js",
    "store:start": "node storefront/server.js",
    "store:sync": "node storefront/scripts/sync-and-test.js",
    "stripe:listen": "node storefront/scripts/stripe-listen.js",
    "headed:balma": "node scripts/headed-balma-switch-demo.js",
    "headed:balma3": "node scripts/headed-balma-3-abos.js",
    "headed:balma-migrate3": "node scripts/headed-balma-migrate-3.js",
    "headed:balma-noabo": "node scripts/headed-balma-no-abo.js",
    "test": "node --test test/*.test.js",
    "test:offers": "node --test test/all-offers.test.js",
    "test:offers:live": "node scripts/test-all-offers.js --live",
    "test:load": "node test/load-queue.test.js",
    "session:export": "node scripts/export-deciplus-session.js",
    "cleanup:test": "node scripts/cleanup-test-subscriptions.js",
    "cleanup:test:execute": "node scripts/cleanup-test-subscriptions.js --execute",
    "import:materiel": "node scripts/import-prestashop-materiel.js",
    "sync:materiel": "node storefront/scripts/sync-prestashop-materiel.js",
    "media:heroes": "node scripts/encode-hero-videos.mjs",
    "vercel-build": "echo Vercel build OK"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.6.6",
    "mailparser": "^3.9.15",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "stripe": "^17.7.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": "24.x"
  }
}
