# =============================================================================
# BOXPLUS — variables à coller dans Vercel
# Project → Settings → Environment Variables → Production (+ Preview si besoin)
# =============================================================================
# Même projet Supabase que gestion-manager (portet_clients, tunnel_leads, boxplus_orders).
# Ne PAS mettre ici les secrets Deciplus / IMAP (ça reste sur BotHosting).
# =============================================================================

# ── URLs publiques ──────────────────────────────────────────────────────────
SITE_URL=https://boutique.boxingcenter.fr
STORE_URL=https://boutique.boxingcenter.fr
CONCOURS_ADMIN_URL=https://concours.boxingcenter.fr/admin

# ── Supabase (OBLIGATOIRE — même URL que gestion-manager) ───────────────────
SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel (alias) :
# NEXT_PUBLIC_SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
# Sur Vercel, BOXPLUS_ORDERS_REMOTE n'est PAS requis (remote auto si VERCEL=1).

# ── Auth admin boutique ─────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=angoularaphael05@gmail.com
SUPER_ADMIN_PASSWORD=
# SESSION_SECRET : chaîne longue aléatoire (pas change-me). Obligatoire en prod.
SESSION_SECRET=
ADMIN_SECRET=
SYNC_SECRET=
# Cron Vercel : Authorization Bearer CRON_SECRET (envoyé auto si la var existe)
CRON_SECRET=
# Doit être IDENTIQUE au SYNC_SECRET / BRIDGE_SECRET du bot BotHosting.

# ── Bot Deciplus (BotHosting) ───────────────────────────────────────────────
BOXPLUS_BOT_URL=http://prem-eu1.bot-hosting.net:20311
# Bot résils / changements / échéancier (BotHosting prem-eu2)
BOXPLUS_BOT_URL_OPS=http://prem-eu2.bot-hosting.net:21268

# ── Paiements ───────────────────────────────────────────────────────────────
# PayPlug LIVE en prod (sk_live_…) — TEST seulement pour Preview
PAYPLUG_SECRET_KEY=
# PAYPLUG_API_VERSION=2019-08-06
# PAYPLUG_ONEY_4X_ENABLED=1

# PayPal — Live en prod
# Minimes + autres salles :
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
# Portet (compte PayPal séparé) — repli si CAWL n’est pas encore branché
PAYPAL_PORTET_CLIENT_ID=
PAYPAL_PORTET_CLIENT_SECRET=

# CAWL ecommerce — Portet (remplace PayPal). PSPID + API Key ID + secret (affiché une seule fois).
CAWL_MERCHANT_ID=
CAWL_API_KEY_ID=
CAWL_API_SECRET=
CAWL_MODE=live
# Visiteurs Portet : paiements fermés le temps des tests CAWL. Studio reste ouvert.
# Remettre à 0 pour réouvrir le live Portet.
PORTET_PAYMENTS_PAUSED=1
# Preview / studio : clés de l’environnement Test du portail CAWL
# CAWL_TEST_MERCHANT_ID=
# CAWL_TEST_API_KEY_ID=
# CAWL_TEST_API_SECRET=
# CAWL_TEST_MODE=test

# Stripe legacy (optionnel — anciennes sessions seulement)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Campagnes clients — Resend (PAS Brevo / suzinabot, domaine banni) ───────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
RESEND_REPLY_TO=boxingcentertls@gmail.com

# ── Emails transactionnels (Brevo API — obligatoire sur Vercel, pas de SMTP) ─
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=Boxing Center
BREVO_REPLY_TO=boxingcenter31@gmail.com
MAIL_FROM=Boxing Center <suzinabot@gmail.com>
MAIL_REPLY_TO=boxingcenter31@gmail.com
ADMIN_EMAIL=angoularaphael05@gmail.com
ALERT_EMAIL=angoularaphael05@gmail.com
MANAGER_EMAIL_DEFAULT=boxingcenter31@gmail.com
# MANAGER_EMAIL_MINIMES=
# MANAGER_EMAIL_RAMONVILLE=
# MANAGER_EMAIL_PORTET=
# MANAGER_EMAIL_ETATS_UNIS=
# MANAGER_EMAIL_ST_CYPRIEN=

# ── Offres / boutique ───────────────────────────────────────────────────────
STORE_DEMO_ENABLED=false
STORE_SYNC_ENABLED=true
OFFRE_RENTREE_QUOTA=60
# OFFRE_RENTREE_FIN=2026-09-30

