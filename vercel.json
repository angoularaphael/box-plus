{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "box-plus.vercel.app" }],
      "destination": "https://boutique.boxingcenter.fr/$1",
      "permanent": true
    },
    {
      "source": "/aventure",
      "destination": "https://aventure.boxingcenter.fr/",
      "permanent": true
    },
    {
      "source": "/aventure.html",
      "destination": "https://aventure.boxingcenter.fr/",
      "permanent": true
    },
    {
      "source": "/boxing-shop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/16-materiel-de-boxe",
      "destination": "/materiel",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{storefront/**,data/storefront/**,lib/**,config/**}"
    },
    "api/sitemap.js": {
      "includeFiles": "{storefront/lib/seo.js,storefront/public/**,data/storefront/materiel-catalog.json}"
    },
    "api/robots.js": {
      "includeFiles": "{storefront/lib/seo.js,data/storefront/materiel-catalog.json}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-catalog",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/deciplus-sale-reconcile",
      "schedule": "*/15 * * * *"
    }
  ]
}
