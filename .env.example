# Deciplus
DECIPLUS_URL=https://manager.deciplus.pro
DECIPLUS_USER=
DECIPLUS_PASSWORD=
DECIPLUS_HEADLESS=false
DECIPLUS_SLOW_MO=0
# Code 2FA manuel (temporaire) — sinon lecture auto IMAP ci-dessous
# DECIPLUS_EMAIL_CODE=
# Boîte qui reçoit le code Deciplus (Gmail = mot de passe d'application, PAS le MDP du compte)
# Créer ici : https://myaccount.google.com/apppasswords
DECIPLUS_IMAP_USER=
DECIPLUS_IMAP_PASS=
# DECIPLUS_IMAP_HOST=imap.gmail.com
# DECIPLUS_IMAP_PORT=993
# DECIPLUS_OTP_WAIT_MS=90000


# Analyzer
ANALYZER_SCENARIO=login
ANALYZER_OUTPUT_DIR=analyzer/output

# Bot
BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_MAX_RETRIES=3
BOT_MIN_DELAY_MS=150
BOT_MAX_DELAY_MS=400
BOT_DELAY_SCALE=0.5
DECIPLUS_NAV_SETTLE_MS=400
DECIPLUS_FAST=1
BOT_CATALOG_TTL_MS=600000

# Bridge (PrestaShop → BOXPLUS) — intégration 100 % Node.js
BRIDGE_PORT=3030
BRIDGE_SECRET=change-me-in-production
BRIDGE_HOST=0.0.0.0
BRIDGE_AUTO_BOT=true
# PrestaShop Webservice (nouveau shop connecté au bot)
PRESTASHOP_URL=https://boutique.example.com
PRESTASHOP_API_KEY=
PRESTASHOP_PAID_STATE_IDS=2
PRESTASHOP_DEFAULT_GYM=minimes
PRESTASHOP_SYNC_MS=60000
PRESTASHOP_SYNC_ENABLED=true

# Boutique Stripe (tests)
STORE_PORT=3040
# Prod Vercel — en local laisser vide ou commenter (→ localhost:3040 automatique)
# STORE_URL=https://box-plus.vercel.app
STRIPE_SECRET_KEY=
# Portet : clé dédiée (peut être identique à STRIPE_SECRET_KEY pour l'instant)
STRIPE_SECRET_KEY_PORTET=
STRIPE_WEBHOOK_SECRET=
# Après N échecs de renouvellement CB, marquer accès bloqué + alerte admin (défaut 3)
STRIPE_UNPAID_BLOCK_AFTER=3
# PayPal : activer dans le Dashboard Stripe (compte Business du club) — payment_method_types card+paypal
# PayPlug — 4× sans frais (Oney) pour l'offre 259 € ; webhook → /api/webhooks/payplug
# Mode TEST: PAYPLUG_SECRET_KEY=sk_test_…  |  LIVE: sk_live_…
# Portail: https://portal.payplug.com/login → Paramètres → Clés API
# PAYPLUG_PORTAL_EMAIL=
# (mot de passe portail: ne pas committer — utiliser scripts/fetch-payplug-test-key.js en local)
PAYPLUG_SECRET_KEY=
# PAYPLUG_API_VERSION=2019-08-06
STORE_SYNC_ENABLED=true
STORE_SYNC_INTERVAL_MS=21600000
SYNC_SECRET=change-me-in-production
# Admin boutique (même comptes que gestion-manager / compta)
SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_EMAIL=angoularaphael05@gmail.com
SUPER_ADMIN_PASSWORD=
SESSION_SECRET=change-me-in-production
# Legacy automation bot (optionnel)
ADMIN_SECRET=change-me-in-production
BOXPLUS_BRIDGE_URL=
# URL publique du bot BotHosting (commandes → bot)
BOXPLUS_BOT_URL=
# Ingest catalogue vers Vercel (défaut: STORE_URL/api/admin/ingest-catalog)
