# Deciplus
DECIPLUS_URL=https://manager.deciplus.pro
DECIPLUS_USER=
DECIPLUS_PASSWORD=
DECIPLUS_HEADLESS=false
DECIPLUS_SLOW_MO=0
# Code 2FA manuel (temporaire) — sinon lecture auto IMAP ci-dessous
# DECIPLUS_EMAIL_CODE=
# Boîte qui reçoit le code Deciplus (Gmail = mot de passe d'application, PAS le MDP du compte)
# Créer ici : https://myaccount.google.com/apppasswords
DECIPLUS_IMAP_USER=
DECIPLUS_IMAP_PASS=
# DECIPLUS_IMAP_HOST=imap.gmail.com
# DECIPLUS_IMAP_PORT=993
# DECIPLUS_OTP_WAIT_MS=90000


# Analyzer
ANALYZER_SCENARIO=login
ANALYZER_OUTPUT_DIR=analyzer/output

# Bot
BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_MAX_RETRIES=3
BOT_MIN_DELAY_MS=150
BOT_MAX_DELAY_MS=400
BOT_DELAY_SCALE=0.5
DECIPLUS_NAV_SETTLE_MS=400
DECIPLUS_FAST=1
BOT_CATALOG_TTL_MS=600000

# Bridge (PrestaShop → BOXPLUS) — intégration 100 % Node.js
BRIDGE_PORT=3030
BRIDGE_SECRET=change-me-in-production
BRIDGE_HOST=0.0.0.0
BRIDGE_AUTO_BOT=true
# PrestaShop Webservice (nouveau shop connecté au bot)
PRESTASHOP_URL=https://boutique.example.com
PRESTASHOP_API_KEY=
PRESTASHOP_PAID_STATE_IDS=2
PRESTASHOP_DEFAULT_GYM=minimes
PRESTASHOP_SYNC_MS=60000
PRESTASHOP_SYNC_ENABLED=true

# Boutique
STORE_PORT=3040
# Prod Vercel — checklist complète : voir .env.vercel.example
# SITE_URL=https://boutique.boxingcenter.fr
# STORE_URL=https://boutique.boxingcenter.fr
# En local laisser vide ou commenter (→ localhost:3040 automatique)
# Stripe — legacy (anciennes sessions). Les nouveaux paiements passent par PayPlug / PayPal natif.
# STRIPE_SECRET_KEY=
# STRIPE_SECRET_KEY_PORTET=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_UNPAID_BLOCK_AFTER=3

# PayPlug — carte 1× (hosted) + 4× Oney ; webhook → /api/webhooks/payplug
# Mode TEST: sk_test_…  |  LIVE: sk_live_…
# Portail: https://portal.payplug.com/login → Paramètres → Clés API
PAYPLUG_SECRET_KEY=
# PAYPLUG_API_VERSION=2019-08-06
# 1 = réactiver le 4× Oney live une fois PayPlug l’a ouvert sur le compte
# PAYPLUG_ONEY_4X_ENABLED=1

# PayPal natif (hors Stripe) — Developer Dashboard → Apps → Client ID + Secret
# Sandbox: PAYPAL_MODE=sandbox  |  Live: PAYPAL_MODE=live
# Activer Pay Later / Paiement en 4X dans le compte Business FR (éligibilité marchand requise)
#
# Compte Minimes + autres salles (Ramonville, États-Unis, Saint-Cyprien) :
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# CAWL ecommerce — Portet : carte 1× / 1ʳᵉ échéance (le 4× reste PayPal Portet)
# Portail : Développeur → API de paiement
# Live  : https://payment.cawl-solutions.fr
# Test  : https://payment.preprod.cawl-solutions.fr  (toggle Test du portail + clés TEST)
CAWL_MERCHANT_ID=
CAWL_API_KEY_ID=
CAWL_API_SECRET=
CAWL_MODE=live
# 1 = visiteurs Portet : paiements fermés (studio / localhost restent ouverts)
# 0 = réouvrir les paiements Portet en live
PORTET_PAYMENTS_PAUSED=1
# Clés TEST — studio / localhost uniquement (overlay CAWL_TEST_*)
CAWL_TEST_MODE=test
CAWL_TEST_MERCHANT_ID=
CAWL_TEST_API_KEY_ID=
CAWL_TEST_API_SECRET=
# Option Oney 4× fournie par Thunes pour le PSPID (si le portail le demande)
# CAWL_ONEY_4X_PAYMENT_OPTION=
# Webhook CAWL : https://boutique.boxingcenter.fr/api/webhooks/cawl
# Webhook PayPal (Dashboard → Webhooks) :
# https://boutique.boxingcenter.fr/api/webhooks/paypal
# Événements : PAYMENT.CAPTURE.COMPLETED, CHECKOUT.ORDER.APPROVED
# PAYPAL_WEBHOOK_ID=

# Clés SANDBOX — utilisées uniquement en mode studio (Chloé).
# En local : fichier env.test. Sur Vercel : renseigner ces variables.
PAYPAL_TEST_MODE=sandbox
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
PAYPAL_TEST_PORTET_CLIENT_ID=
PAYPAL_TEST_PORTET_CLIENT_SECRET=
PAYPLUG_TEST_SECRET_KEY=
STORE_SYNC_ENABLED=true
STORE_SYNC_INTERVAL_MS=21600000
SYNC_SECRET=change-me-in-production
# Admin boutique + inscriptions → MÊME projet Supabase que gestion-manager
# (NEXT_PUBLIC_SUPABASE_URL côté gestion-manager = cette SUPABASE_URL)
SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
# Alias accepté par le client (même valeur que gestion-manager) :
# NEXT_PUBLIC_SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Sur Vercel les commandes vont dans boxplus_orders (remote auto si VERCEL=1).
# En local / BotHosting, forcer le dual-write Supabase :
# BOXPLUS_ORDERS_REMOTE=1
# Même chose pour les visites boutique (sinon le compteur 30 j reste à 1 sur Vercel) :
# BOXPLUS_ANALYTICS_REMOTE=1
# Les clients landent dans portet_clients (source=boxplus) + leads tunnels dans tunnel_leads.
SUPER_ADMIN_EMAIL=angoularaphael05@gmail.com
SUPER_ADMIN_PASSWORD=
SESSION_SECRET=change-me-in-production
# Code interne Chloé — obligatoire, pas de valeur par défaut
DEV_UNLOCK_CODE=
# Cron Vercel / relances inscription
CRON_SECRET=
# Legacy automation bot (optionnel)
ADMIN_SECRET=change-me-in-production
BOXPLUS_BRIDGE_URL=
# URL publique du bot BotHosting (commandes → bot)
BOXPLUS_BOT_URL=
BOXPLUS_BOT_URL_OPS=
# Auto-migration Balma sur toutes les ventes (0 = page Aventure seulement)
BALMA_AUTOMIGRATE_ON_SALE=0
STORE_URL=https://boutique.boxingcenter.fr
# Admin concours 10 ans — page boutique /admin/concours
CONCOURS_ADMIN_URL=https://concours.boxingcenter.fr/admin
# Ingest catalogue vers Vercel (défaut: STORE_URL/api/admin/ingest-catalog)
# STORE_INGEST_URL=https://boutique.boxingcenter.fr/api/admin/ingest-catalog

# Matériel — sync stock/prix PrestaShop (hybride)
# PRESTASHOP_URL=https://boutique.boxingcenter.fr
# PRESTASHOP_API_KEY=
# npm run import:materiel  — import initial depuis miroir prestashop/
# npm run sync:materiel    — sync API live

# Campagnes clients (29 € / 259 €) — Resend, PAS Brevo (suzinabot banni)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
RESEND_REPLY_TO=boxingcentertls@gmail.com

# Email confirmation inscription / matériel (Brevo API — même expéditeur que gestion-manager)
# Sur Vercel : BREVO_API_KEY (xkeysib-…) obligatoire — pas de SMTP (blocage IP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=Boxing Center
BREVO_REPLY_TO=boxingcenter31@gmail.com
MAIL_FROM=Boxing Center <suzinabot@gmail.com>
MAIL_REPLY_TO=boxingcenter31@gmail.com
# Repli SMTP local uniquement (dev)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# Emails responsables de salle (réservation coaching)
# Si non défini pour une salle → MANAGER_EMAIL_DEFAULT (sinon boxingcenter31@gmail.com)
MANAGER_EMAIL_DEFAULT=boxingcenter31@gmail.com
MANAGER_EMAIL_MINIMES=
MANAGER_EMAIL_RAMONVILLE=
MANAGER_EMAIL_PORTET=
MANAGER_EMAIL_ETATS_UNIS=
MANAGER_EMAIL_ST_CYPRIEN=

# Alertes (optionnel)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Groq — conseillers Chloe / David (fallback si quota ou erreur API)
# GROQ_API_KEY=
# GROQ_API_KEY_FALLBACK=
# GROQ_MODEL=openai/gpt-oss-120b

# ── Offre de rentrée : le compteur de places affiché sur les sites du club ──
# Le nombre « plus que N places » servi par /api/offre-rentree/places est
# calculé : QUOTA moins les inscriptions RÉELLEMENT payées sur offre-duo et
# offre-saison. Il ne s'invente pas — annoncer une rareté qui n'existe pas est
# une pratique commerciale trompeuse (code de la consommation, art. L.121-2).
# QUOTA est la décision du patron : combien de places il ouvre à ce prix.
OFFRE_RENTREE_QUOTA=60
# Date de fin de l'offre, au format AAAA-MM-JJ. Vide = pas de date affichée.
OFFRE_RENTREE_FIN=

# WhatsApp parrainage Offre Duo 29 € — désormais envoyé en SMS (gateway Android)
SMS_GATEWAY_URL=http://prem-eu2.bot-hosting.net:21724
SMS_GATEWAY_SECRET=
SMS_GATEWAY_EMAIL=
SMS_GATEWAY_PASSWORD=
# WHATSAPP_BOT_URL / WHATSAPP_BOT_SECRET : plus utilisés pour l'envoi

# Cloudinary — photos membres (local optionnel, obligatoire sur Vercel)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
