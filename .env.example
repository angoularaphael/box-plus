# Matériel — sync stock/prix PrestaShop (hybride)
# PRESTASHOP_URL=https://boutique.boxingcenter.fr
# PRESTASHOP_API_KEY=
# npm run import:materiel  — import initial depuis miroir prestashop/
# npm run sync:materiel    — sync API live

# Email confirmation inscription / matériel (Brevo API — même expéditeur que gestion-manager)
# Sur Vercel : BREVO_API_KEY (xkeysib-…) obligatoire — pas de SMTP (blocage IP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=Boxing Center
BREVO_REPLY_TO=boxingcenter31@gmail.com
MAIL_FROM=Boxing Center <suzinabot@gmail.com>
MAIL_REPLY_TO=boxingcenter31@gmail.com
# Repli SMTP local uniquement (dev)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# Emails responsables de salle (réservation coaching)
# Si non défini pour une salle → MANAGER_EMAIL_DEFAULT (sinon boxingcenter31@gmail.com)
MANAGER_EMAIL_DEFAULT=boxingcenter31@gmail.com
MANAGER_EMAIL_MINIMES=
MANAGER_EMAIL_RAMONVILLE=
MANAGER_EMAIL_PORTET=
MANAGER_EMAIL_ETATS_UNIS=
MANAGER_EMAIL_ST_CYPRIEN=

# Alertes (optionnel)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# ── Offre de rentrée : le compteur de places affiché sur les sites du club ──
# Le nombre « plus que N places » servi par /api/offre-rentree/places est
# calculé : QUOTA moins les inscriptions RÉELLEMENT payées sur offre-duo et
# offre-saison. Il ne s'invente pas — annoncer une rareté qui n'existe pas est
# une pratique commerciale trompeuse (code de la consommation, art. L.121-2).
# QUOTA est la décision du patron : combien de places il ouvre à ce prix.
OFFRE_RENTREE_QUOTA=60
# Date de fin de l'offre, au format AAAA-MM-JJ. Vide = pas de date affichée.
OFFRE_RENTREE_FIN=
